{
  "name": "graphflow-vscode",
  "publisher": "roarpeng",
  "displayName": "GraphFlow",
  "description": "GraphFlow orchestration panel and command runner",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roarpeng/GraphFlow.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:graphflow.runTask",
    "onCommand:graphflow.showRuns"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphflow.runTask",
        "title": "GraphFlow: Run Task"
      },
      {
        "command": "graphflow.showRuns",
        "title": "GraphFlow: Show Runs"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies --out ../artifacts/graphflow-vscode-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "graphflow": "file:.."
  }
}
