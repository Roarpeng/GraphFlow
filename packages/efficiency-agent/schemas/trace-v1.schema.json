{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Roarpeng/GraphFlow/main/packages/efficiency-agent/schemas/trace-v1.schema.json",
  "title": "GraphFlow Efficiency Agent benchmark task trace v1",
  "type": "object",
  "required": ["schemaVersion", "traceId", "task", "run", "context", "llm", "tools", "rounds", "validation", "result"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "traceId": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "required": ["text", "category"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string" },
        "category": {
          "enum": ["query", "single-file", "multi-file", "bugfix", "refactor", "test", "docs", "config", "cross-module", "deliberate-failure"]
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["worker", "mode", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["baseline", "shadow", "conservative", "adaptive"] },
        "arm": { "enum": ["baseline", "graphflow", "shadow", "conservative", "adaptive"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "context": { "$ref": "#/$defs/context" },
    "llm": { "$ref": "#/$defs/llm" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "calls"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "calls": { "$ref": "#/$defs/measurement" },
          "latencyMs": { "$ref": "#/$defs/measurement" }
        }
      }
    },
    "rounds": { "$ref": "#/$defs/measurement" },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["success"],
      "additionalProperties": false,
      "properties": { "success": { "type": "boolean" } }
    },
    "sessionId": { "type": "string" },
    "projectId": { "type": "string" },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}\\|[0-9a-f]{16}\\|[0-9a-f]{16}\\|[0-9a-f]{16}$"
    },
    "model": {
      "type": "object",
      "required": ["provider", "tier"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "tier": { "type": "string" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimated": { "$ref": "#/$defs/measurement" },
        "actual": { "$ref": "#/$defs/measurement" }
      }
    },
    "validationStatus": { "enum": ["passed", "failed", "unverified", "not-run"] },
    "securityDecision": {
      "type": "object",
      "required": ["verdict", "risk", "reasons"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["allow", "deny", "approval-required"] },
        "risk": { "enum": ["R0", "R1", "R2", "R3", "R4", "R5"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "record": {
      "type": "object",
      "description": "Spec section 24: everything a decision stores for replay and rollback.",
      "required": ["decisionId", "policyVersion", "contractVersion", "toolVersions", "cacheNamespace"],
      "additionalProperties": false,
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "integer", "minimum": 0 },
        "contractVersion": { "type": "string" },
        "workerVersion": { "type": "string" },
        "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
        "cacheNamespace": { "type": "string" },
        "securityPolicyVersion": { "type": "string" },
        "requestedMode": { "enum": ["advisory", "baseline", "shadow", "conservative", "adaptive"] },
        "flags": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    },
    "events": {
      "type": "array",
      "description": "Spec section 3: every state transition with reason, evidence and policy version.",
      "items": {
        "type": "object",
        "required": ["at", "stage", "outcome", "reason", "evidence", "policyVersion"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "stage": {
            "enum": ["flags", "fingerprint", "twin", "experience", "context", "reuse-gate", "security", "tool-routing", "model-routing", "cost", "execute", "validate", "replan", "learn", "fail-open"]
          },
          "outcome": { "type": "string" },
          "reason": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "policyVersion": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "regression": {
      "type": "object",
      "required": ["passed", "checks"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "passed"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "passed": { "type": "boolean" } }
          }
        }
      }
    },
    "judged": {
      "type": "boolean",
      "description": "Whether an oracle judged result.success. Unjudged traces never enter a success rate."
    },
    "oracle": {
      "type": "object",
      "required": ["passed", "checks"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "passed"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["reuseMode", "durationMs", "llmCalls"],
      "additionalProperties": false,
      "properties": {
        "reuseMode": { "enum": ["REUSE", "ADAPT", "FRESH"] },
        "durationMs": { "$ref": "#/$defs/measurement" },
        "llmCalls": { "$ref": "#/$defs/measurement" },
        "costShare": { "$ref": "#/$defs/measurement" }
      }
    },
    "failure": {
      "type": "object",
      "required": ["stage", "reason"],
      "additionalProperties": false,
      "properties": {
        "stage": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "provenance": { "enum": ["measured", "estimated", "proxy"] },
        "method": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "if": { "properties": { "provenance": { "const": "measured" } } },
      "then": { "properties": { "method": false, "confidence": false } },
      "else": { "required": ["method"], "properties": { "method": { "type": "string" } } }
    },
    "context": {
      "type": "object",
      "required": ["tokens", "anchors", "cacheHit"],
      "additionalProperties": false,
      "properties": {
        "tokens": { "$ref": "#/$defs/measurement" },
        "anchors": { "type": "integer", "minimum": 0 },
        "cacheHit": { "type": "boolean" },
        "invalidationReason": { "type": "string" }
      }
    },
    "llm": {
      "type": "object",
      "required": ["calls"],
      "additionalProperties": false,
      "properties": {
        "calls": { "$ref": "#/$defs/measurement" },
        "inputTokens": { "$ref": "#/$defs/measurement" },
        "outputTokens": { "$ref": "#/$defs/measurement" },
        "totalTokens": { "$ref": "#/$defs/measurement" },
        "costUsd": { "$ref": "#/$defs/measurement" }
      }
    }
  }
}
