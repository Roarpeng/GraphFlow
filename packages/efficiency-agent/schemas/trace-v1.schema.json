{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Roarpeng/GraphFlow/main/packages/efficiency-agent/schemas/trace-v1.schema.json",
  "title": "GraphFlow Efficiency Agent benchmark task trace v1",
  "type": "object",
  "required": ["schemaVersion", "traceId", "task", "run", "context", "llm", "tools", "rounds", "validation", "result"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "traceId": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "required": ["text", "category"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string" },
        "category": {
          "enum": ["query", "single-file", "multi-file", "bugfix", "refactor", "test", "docs", "config", "cross-module", "deliberate-failure"]
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["worker", "mode", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["baseline", "shadow", "conservative", "adaptive"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "context": { "$ref": "#/$defs/context" },
    "llm": { "$ref": "#/$defs/llm" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "calls"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "calls": { "$ref": "#/$defs/measurement" },
          "latencyMs": { "$ref": "#/$defs/measurement" }
        }
      }
    },
    "rounds": { "$ref": "#/$defs/measurement" },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["success"],
      "additionalProperties": false,
      "properties": { "success": { "type": "boolean" } }
    },
    "decision": {
      "type": "object",
      "required": ["reuseMode", "durationMs", "llmCalls"],
      "additionalProperties": false,
      "properties": {
        "reuseMode": { "enum": ["REUSE", "ADAPT", "FRESH"] },
        "durationMs": { "$ref": "#/$defs/measurement" },
        "llmCalls": { "$ref": "#/$defs/measurement" },
        "costShare": { "$ref": "#/$defs/measurement" }
      }
    },
    "failure": {
      "type": "object",
      "required": ["stage", "reason"],
      "additionalProperties": false,
      "properties": {
        "stage": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "provenance": { "enum": ["measured", "estimated", "proxy"] },
        "method": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "context": {
      "type": "object",
      "required": ["tokens", "anchors", "cacheHit"],
      "additionalProperties": false,
      "properties": {
        "tokens": { "$ref": "#/$defs/measurement" },
        "anchors": { "type": "integer", "minimum": 0 },
        "cacheHit": { "type": "boolean" },
        "invalidationReason": { "type": "string" }
      }
    },
    "llm": {
      "type": "object",
      "required": ["calls"],
      "additionalProperties": false,
      "properties": {
        "calls": { "$ref": "#/$defs/measurement" },
        "inputTokens": { "$ref": "#/$defs/measurement" },
        "outputTokens": { "$ref": "#/$defs/measurement" },
        "totalTokens": { "$ref": "#/$defs/measurement" },
        "costUsd": { "$ref": "#/$defs/measurement" }
      }
    }
  }
}
