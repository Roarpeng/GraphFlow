{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Roarpeng/GraphFlow/main/packages/efficiency-agent/schemas/execution-contract-v1.schema.json",
  "title": "GraphFlow Efficiency Agent execution contract v1",
  "description": "Superset evolution of graphflow_run's executionDescriptor: the descriptor keeps task/context/steps; the contract adds the efficiency verdicts (reuse/model/execution/validation) and the decision's own cost. The substrate emits this shape as the `advisory` block on graphflow_run responses.",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "mode",
    "reuseMode",
    "confidence",
    "signals",
    "context",
    "worker",
    "validation",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "shadow",
        "conservative",
        "adaptive"
      ]
    },
    "reuseMode": {
      "enum": [
        "REUSE",
        "ADAPT",
        "FRESH"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "object",
      "required": [
        "taskComplexity",
        "executionMode",
        "fusedStepCount",
        "similarEpisodeCount"
      ],
      "additionalProperties": false,
      "properties": {
        "taskComplexity": {
          "enum": [
            "simple",
            "complex"
          ]
        },
        "executionMode": {
          "enum": [
            "bridge",
            "llm"
          ]
        },
        "fusedStepCount": {
          "type": "integer",
          "minimum": 0
        },
        "similarEpisodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "topEpisodeScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "topEpisodeSimilarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "source",
        "requiredAnchors"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "graphflow"
        },
        "requiredAnchors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "boolean"
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "modelTier",
        "executionMode",
        "maxRounds"
      ],
      "additionalProperties": false,
      "properties": {
        "modelTier": {
          "enum": [
            "economy",
            "standard",
            "heavy"
          ]
        },
        "executionMode": {
          "enum": [
            "one-shot",
            "loop"
          ]
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "provenance",
        "llmCalls",
        "durationMs"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "enum": [
            "deterministic",
            "llm"
          ]
        },
        "llmCalls": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "deterministic"
              }
            }
          },
          "then": {
            "properties": {
              "llmCalls": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "gitHead": {
          "type": "string",
          "minLength": 1
        },
        "workingTreeHash": {
          "type": "string"
        },
        "graphVersion": {
          "type": "string"
        },
        "toolchainHash": {
          "type": "string"
        }
      }
    },
    "experience": {
      "type": "object",
      "required": [
        "episodes"
      ],
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topSimilarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoidPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "capability"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "R0",
              "R1",
              "R2",
              "R3",
              "R4",
              "R5"
            ]
          }
        }
      }
    },
    "policyApplied": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique per decision: replay and rollback key (spec section 24)."
    },
    "reuseEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validationPolicy": {
      "type": "object",
      "required": [
        "required",
        "evidenceRequired"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "evidenceRequired": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxToolCalls",
        "maxRounds",
        "maxWallMs"
      ],
      "additionalProperties": false,
      "properties": {
        "maxInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 0
        },
        "maxWallMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "read",
        "write",
        "network"
      ],
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network": {
          "type": "boolean"
        }
      }
    }
  }
}
