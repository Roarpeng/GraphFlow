<?xml version="1.0" encoding="UTF-8"?>
<!-- OpenPLC Traffic Light Controller - Comprehensive PLCopen XML Test -->
<project xmlns="http://www.plcopen.org/xml/tc6.xsd"
         xmlns:xhtml="http://www.w3.org/1999/xhtml"
         xmlns:ppx="http://www.plcopen.org/xml/tc6_ppx">
  <fileHeader companyName="AutonomyLogic" productName="OpenPLC Editor" productVersion="3.0"
              creationDateTime="2026-01-15T10:00:00"/>

  <contentHeader name="TrafficLight" version="1.0" modificationDateTime="2026-07-24T08:00:00">
    <coordinateInfo>
      <fbd><scaling x="0" y="0"/></fbd>
      <ld><scaling x="0" y="0"/></ld>
      <sfc><scaling x="0" y="0"/></sfc>
    </coordinateInfo>
    <addData>
      <data name="build-version" handleUnknown="discard">
        <buildEnv os="linux" python="3.11" wx="4.2"/>
      </data>
    </addData>
  </contentHeader>

  <types>
    <!-- Custom data types -->
    <dataTypes>
      <dataType name="TRAFFIC_STATE">
        <baseType>
          <DINT/>
        </baseType>
        <initialValue>
          <simpleValue value="0"/>
        </initialValue>
      </dataType>
      <dataType name="DIAGNOSTIC_STRUCT">
        <baseType>
          <struct>
            <variable name="errorCode">
              <type><INT/></type>
            </variable>
            <variable name="severity">
              <type><USINT/></type>
            </variable>
            <variable name="timestamp">
              <type><TIME/></type>
            </variable>
          </struct>
        </baseType>
      </dataType>
    </dataTypes>

    <pous>
      <!-- ===== FUNCTION BLOCK: Timer ===== -->
      <pou name="TrafficTimer" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="preset">
              <type><TIME/></type>
              <initialValue><simpleValue value="T#5s"/></initialValue>
            </variable>
            <variable name="enable">
              <type><BOOL/></type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="elapsed">
              <type><derived name="TIME"/></type>
            </variable>
            <variable name="done">
              <type><BOOL/></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="ton1">
              <type><derived name="TON"/></type>
            </variable>
            <variable name="accumulator">
              <type><DINT/></type>
              <retain/>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml><![CDATA[
(* Traffic timer with edge-triggered enable *)
ton1(IN := enable, PT := preset);

IF NOT enable THEN
  elapsed := T#0s;
  done := FALSE;
  accumulator := 0;
END_IF;

IF ton1.Q THEN
  elapsed := ton1.ET;
  done := TRUE;
  accumulator := accumulator + 1;
END_IF;
]]></xhtml>
          </ST>
        </body>
      </pou>

      <!-- ===== FUNCTION: State Machine Logic ===== -->
      <pou name="NextState" pouType="function">
        <interface>
          <returnType><INT/></returnType>
          <inputVars>
            <variable name="current">
              <type><derived name="TRAFFIC_STATE"/></type>
            </variable>
            <variable name="overrideReq">
              <type><BOOL/></type>
            </variable>
          </inputVars>
        </interface>
        <body>
          <ST>
            <xhtml><![CDATA[
// Emergency override has highest priority
IF overrideReq THEN
  NextState := 0;  (* FLASHING_RED *)
  RETURN;
END_IF;

// Normal state machine
CASE current OF
  0:  // RED → GREEN after delay
    NextState := 1;
  1:  // GREEN → YELLOW after delay
    NextState := 2;
  2:  // YELLOW → RED after delay
    NextState := 0;
  3:  // FLASHING mode
    NextState := 4;
  4:
    NextState := 3;
END_CASE;
]]></xhtml>
          </ST>
        </body>
      </pou>

      <!-- ===== PROGRAM: Main Controller ===== -->
      <pou name="main" pouType="program">
        <interface>
          <localVars>
            <variable name="state">
              <type><derived name="TRAFFIC_STATE"/></type>
              <initialValue><simpleValue value="0"/></initialValue>
            </variable>
            <variable name="redLight">
              <type><BOOL/></type>
              <address>%QX0.0</address>
            </variable>
            <variable name="yellowLight">
              <type><BOOL/></type>
              <address>%QX0.1</address>
            </variable>
            <variable name="greenLight">
              <type><BOOL/></type>
              <address>%QX0.2</address>
            </variable>
            <variable name="phaseTimer">
              <type><derived name="TrafficTimer"/></type>
            </variable>
            <variable name="emergencyStop">
              <type><BOOL/></type>
              <address>%IX1.0</address>
            </variable>
            <variable name="loopCounter">
              <type><DINT/></type>
            </variable>
          </localVars>
          <inputVars>
            <variable name="systemClock">
              <type><TIME/></type>
              <address>%MD100</address>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="statusWord">
              <type><INT/></type>
              <address>%MW50</address>
            </variable>
          </outputVars>
          <inOutVars>
            <variable name="configBlock">
              <type><derived name="DIAGNOSTIC_STRUCT"/></type>
            </variable>
          </inOutVars>
          <tempVars>
            <variable name="tmpResult">
              <type><DINT/></type>
            </variable>
          </tempVars>
        </interface>
        <body>
          <ST>
            <xhtml><![CDATA[
(* Main traffic light controller *)
state := NextState(state, emergencyStop);

(* Configure timer based on state *)
CASE state OF
  0:  // RED phase
    redLight := TRUE;
    yellowLight := FALSE;
    greenLight := FALSE;
    phaseTimer.enable := FALSE;
    phaseTimer.preset := T#30s;

  1:  // GREEN phase
    redLight := FALSE;
    greenLight := TRUE;
    phaseTimer.enable := TRUE;
    phaseTimer.preset := T#30s;

  2:  // YELLOW phase
    greenLight := FALSE;
    yellowLight := TRUE;
    phaseTimer.enable := TRUE;
    phaseTimer.preset := T#5s;

  3:  // FLASHING_RED (emergency)
    ldToggle := NOT ldToggle;
    redLight := ldToggle;
    yellowLight := FALSE;
    greenLight := FALSE;
    statusWord := statusWord + 1;
END_CASE;

(* Update timer *)
phaseTimer();

(* Loop counting *)
FOR loopCounter := 0 TO 1000 DO
  tmpResult := loopCounter * 2;
  IF tmpResult > 500 THEN
    EXIT;
  END_IF;
END_FOR;
]]></xhtml>
          </ST>
        </body>
      </pou>

      <!-- ===== FUNCTION BLOCK: Diagnostic Logger ===== -->
      <pou name="DiagnosticLogger" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="logIndex">
              <type><DINT/></type>
            </variable>
            <variable name="logArray">
              <type>
                <array>
                  <dimension lower="0" upper="99"/>
                  <baseType><STRING/></baseType>
                </array>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml><![CDATA[
WHILE logIndex < 100 DO
  logArray[logIndex] := '';
  logIndex := logIndex + 1;
END_WHILE;
]]></xhtml>
          </ST>
        </body>
      </pou>

      <!-- ===== FUNCTION BLOCK: Edge Detector ===== -->
      <pou name="R_TRIG_Impl" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="CLK">
              <type><BOOL/></type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Q">
              <type><BOOL/></type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="M">
              <type><BOOL/></type>
              <initialValue><simpleValue value="FALSE"/></initialValue>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml><![CDATA[
Q := CLK AND NOT M;
M := CLK;
]]></xhtml>
          </ST>
        </body>
      </pou>
    </pous>
  </types>

  <instances>
    <configurations>
      <configuration name="DefaultConfig">
        <resource name="RaspberryPi">
          <task name="FastTask" priority="10" interval="20ms">
            <pouInstance name="mainInstance" typeName="main"/>
          </task>
          <task name="SlowTask" priority="20" interval="100ms">
            <pouInstance name="diagInstance" typeName="DiagnosticLogger"/>
          </task>
        </resource>
      </configuration>
    </configurations>
  </instances>
</project>
