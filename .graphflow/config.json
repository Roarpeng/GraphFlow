{
  "providers": {},
  "tiers": {
    "smart": { "provider": "openai", "model": "gpt-4.1" },
    "economy": { "provider": "openai", "model": "gpt-4.1-mini" }
  },
  "budgetPolicy": {
    "runTokenCap": 2000
  },
  "graphPolicy": {
    "enableAutoBuild": true,
    "enableNearLosslessMode": true,
    "autoIndexOnPreview": true,
    "autoIndexOnRun": true,
    "workspaceRoot": ".",
    "includeExtensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".md",
      ".json"
    ],
    "transport": "file",
    "graphStorePath": "tmp/graphflow-graph.json",
    "maxContextTokens": 1200,
    "layerQuota": {
      "l1": 6,
      "l2": 4,
      "l3": 3
    },
    "semanticEnrichment": {
      "enabled": true,
      "mode": "post-index",
      "model": "deepseek-v4-flash",
      "batchSize": 5,
      "sleepMs": 0,
      "timeoutMs": 5000,
      "autoRunOnIndex": true
    }
  },
  "learningPolicy": {
    "enableFlywheel": true,
    "trainingCadence": "nightly",
    "canaryRatio": 10,
    "exportPath": "tmp/learning-dataset.jsonl",
    "eventsPath": "tmp/learning-events.jsonl",
    "summaryPath": "tmp/learning-summary.json",
    "skillEvolution": {
      "enabled": true,
      "model": "deepseek-v4-flash",
      "minCoOccur": 2,
      "minSuccess": 2,
      "enableTripleFusion": true
    }
  },
  "routingPolicy": {
    "enableDynamicRouting": true,
    "requireApiKeyForHealthy": false,
    "providerPriority": ["openai"]
  },
  "skillPolicy": {
    "enableSkillFlywheel": true,
    "maxSkillHints": 3
  }
}
