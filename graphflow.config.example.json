{
  "providers": {
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1"
    },
    "deepseek": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "baseUrl": "https://api.deepseek.com"
    },
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}"
    },
    "bailian": {
      "apiKey": "${BAILIAN_API_KEY}"
    },
    "doubao": {
      "apiKey": "${DOUBAO_API_KEY}"
    },
    "openbmb": {
      "mode": "embedded",
      "engine": "command",
      "commandPath": "${GRAPHFLOW_MINICPM_COMMAND}",
      "modelPath": "${GRAPHFLOW_MINICPM_MODEL_PATH}",
      "baseUrl": "http://localhost:11434",
      "timeoutMs": 5000,
      "maxTokens": 256,
      "temperature": 0.1
    }
  },
  "tiers": {
    "smart": { "provider": "openai", "model": "gpt-4.1" },
    "economy": { "provider": "openai", "model": "gpt-4.1-mini" }
  },
  "budgetPolicy": {
    "runTokenCap": 4000
  },
  "graphPolicy": {
    "enableAutoBuild": true,
    "enableNearLosslessMode": true,
    "autoIndexOnPreview": true,
    "autoIndexOnRun": true,
    "autoIndexOnSave": true,
    "includeExtensions": [".ts", ".tsx", ".js", ".jsx", ".md", ".json", ".py", ".rs", ".go", ".c", ".h", ".cpp", ".cc", ".hpp", ".java", ".rb"],
    "transport": "file",
    "graphStorePath": "graphflow-out/graphflow-graph.json",
    "maxContextTokens": 1500,
    "layerQuota": { "l1": 6, "l2": 4, "l3": 3 },
    "semanticEnrichment": {
      "enabled": true,
      "mode": "post-index",
      "model": "minicpm5-1b",
      "batchSize": 5,
      "sleepMs": 1000,
      "timeoutMs": 5000,
      "autoRunOnIndex": true
    },
    "compression": {
      "enabled": false,
      "backend": "inherit",
      "enableGraphCompression": true,
      "enableRepoMapFallback": false,
      "enableAdaptiveBudget": true,
      "autoDownloadEmbedded": true,
      "timeoutMs": 5000
    }
  },
  "learningPolicy": {
    "enableFlywheel": true,
    "trainingCadence": "nightly",
    "canaryRatio": 10,
    "exportPath": "graphflow-out/learning-dataset.jsonl",
    "eventsPath": "graphflow-out/learning-events.jsonl",
    "summaryPath": "graphflow-out/learning-summary.json",
    "skillEvolution": {
      "enabled": true,
      "model": "minicpm5-1b",
      "minCoOccur": 2,
      "minSuccess": 2,
      "enableTripleFusion": true
    }
  },
  "routingPolicy": {
    "enableDynamicRouting": true,
    "requireApiKeyForHealthy": false,
    "providerPriority": ["openai", "anthropic", "bailian", "doubao", "openbmb"]
  },
  "skillPolicy": {
    "enableSkillFlywheel": true,
    "maxSkillHints": 3
  },
  "embeddingPolicy": {
    "enabled": true,
    "provider": "transformers",
    "model": "Xenova/bge-base-zh-v1.5",
    "vectorStorePath": "graphflow-out/vectors.db",
    "topK": 8,
    "minSimilarity": 0.05
  }
}
