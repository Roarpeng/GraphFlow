# onnxruntime-node (pulled in transitively by @huggingface/transformers) tries to
# download large Linux/x64 CUDA GPU binaries from GitHub Releases during install.
# GraphFlow only uses CPU inference, and the download is flaky in CI (ECONNRESET),
# so skip it. The bundled CPU binary is still used.
onnxruntime-node-install-cuda=skip
