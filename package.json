{
  "name": "@roarpeng/graphflow",
  "version": "3.1.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "description": "Token-First Surgical Code Engine for AI Coding Agents (6-Language AST Slicer, Blast-Radius Guard, Output Dehydrator, Habit & Git Co-Change Macros)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "graphflow": "dist/cli.js",
    "graphflow-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "start:mcp": "tsx src/mcp-server.ts",
    "test": "tsx tests/graphflow.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
