{
  "name": "@roarpeng/graphflow",
  "version": "3.5.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "mcp.json",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "VSIX-INSTALL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "description": "Token-First Surgical Code Engine for AI Coding Agents (true AST for TS/JS via @babel/parser and for Python/Go/Rust/C/C++/C# via optional tree-sitter grammars, receiver-aware Blast-Radius Guard, Output Dehydrator, Habit & Git Co-Change Macros)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "graphflow": "dist/cli.js",
    "graphflow-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "start:mcp": "tsx src/mcp-server.ts",
    "test": "tsx tests/run-all.ts",
    "bench": "node scripts/benchmark.mjs",
    "preflight": "node scripts/release-preflight.mjs",
    "preflight:release": "node scripts/release-preflight.mjs --with-tests --with-package",
    "verify:parsers": "node scripts/verify-parsers.mjs",
    "verify:parsers:strict": "node scripts/verify-parsers.mjs --strict"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Roarpeng/GraphFlow"
  },
  "author": "Roarpeng",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Roarpeng/GraphFlow/issues"
  },
  "homepage": "https://github.com/Roarpeng/GraphFlow#readme",
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tree-sitter": "0.22.4"
  },
  "optionalDependencies": {
    "tree-sitter-c": "0.23.6",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-python": "0.23.6",
    "tree-sitter-rust": "0.24.0"
  },
  "overrides": {
    "tree-sitter": "0.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
