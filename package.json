{
  "name": "@roarpeng/graphflow",
  "version": "1.0.8",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "wasm",
    "scripts/safe-postinstall.cjs",
    "src/surfaces/trae-skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "packageManager": "npm@10.9.2",
  "description": "**A Context-Aware Multi-Agent Orchestration Engine**",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "graphflow": "dist/surfaces/cli/index.js",
    "graphflow-mcp": "dist/surfaces/mcp/server.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "postinstall": "node scripts/safe-postinstall.cjs",
    "prepublishOnly": "npm run build && npm run wasm:download",
    "wasm:download": "node scripts/download-wasm-grammars.cjs",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.cjs",
    "test:watch": "vitest",
    "start": "tsx src/surfaces/cli/index.ts",
    "start:mcp": "tsx src/surfaces/mcp/server.ts",
    "lint": "eslint .",
    "build:extension": "npm --prefix vscode-extension run build",
    "test:extension": "npm --prefix vscode-extension run test:runtime",
    "package:extension": "npm --prefix vscode-extension run package",
    "ci": "npm run lint && npm run build && npm test && npm run build:extension && npm run test:extension",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roarpeng/GraphFlow.git"
  },
  "keywords": [
    "multi-agent",
    "orchestration",
    "mcp",
    "context-engine",
    "cursor",
    "claude-code"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Roarpeng/GraphFlow/issues"
  },
  "homepage": "https://github.com/Roarpeng/GraphFlow#readme",
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "gpt-tokenizer": "^3.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "web-tree-sitter": "^0.20.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0",
    "hnswlib-node": "^3.0.0",
    "node-llama-cpp": "^3.15.6"
  }
}
