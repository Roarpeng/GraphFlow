+/**
+ * GraphFlow 3.0 — Pillar 2B: Surgical Symbol/Line Edit & Instant Post-Edit Static Guard (`gf_edit`)
+ *
+ * Lets the LLM edit a file by:
+ *   1. Symbol replacement (`symbol: "resolveEfficiencyPolicy", newCode: "..."`) — replaces
+ *      the exact AST span (`line`..`endLine`) of that symbol without needing oldCode repetition!
+ *   2. Exact line-range replacement (`startLine: 42, endLine: 58, newCode: "..."`)
+ *   3. Exact search-and-replace (`oldCode: "...", newCode: "..."`)
+ *
+ * Immediately after applying the edit in memory, runs the **Zero-LLM Instant Static Guard**:
+ *   - Parses the new file with the AST engine (`@babel/parser` / TS) to catch any syntax
+ *     errors BEFORE or UPON writing (if `rejectOnSyntaxError !== false`, rolls back and
+ *     returns the exact syntax error line so the workspace is never left broken!).
+ *   - Verifies that relative imports in the edited file resolve on disk.
+ *   - Checks **Signature/Arity Drift vs Workspace Call-Sites**: if an edited function's
+ *     parameter count changed or an exported symbol was removed while external files still
+ *     import/call it, immediately reports the exact broken caller `file:line`!
+ */
+
+import { existsSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { analyzeSourceFile, resolveRelativeImportPath } from "./ast-engine.js";
+import { computeBlastRadius } from "./blast-radius.js";
+import { formatNumberedLines, getWorkspaceAstIndex } from "./slicer.js";
+
+export interface SurgicalEditInput {
+  rootDir: string;
+  /** Workspace-relative file path. */
+  file: string;
+  /** Target symbol name to replace in-place (uses AST `line`..`endLine`). */
+  symbol?: string;
+  /** 1-based inclusive start line (alternative to `symbol` or `oldCode`). */
+  startLine?: number;
+  /** 1-based inclusive end line (alternative to `symbol` or `oldCode`). */
+  endLine?: number;
+  /** Exact substring to replace (alternative to `symbol` or `startLine`..`endLine`). */
+  oldCode?: string;
+  /** Replacement code. */
+  newCode: string;
+  /** Roll back edit if AST syntax errors are introduced (default true). */
+  rejectOnSyntaxError?: boolean;
+}
+
+export interface StaticGuardDiagnostic {
+  severity: "error" | "warn";
+  kind: "syntax" | "broken-import" | "caller-arity-mismatch" | "removed-export-still-imported";
+  location: string;
+  message: string;
+}
+
+export interface SurgicalEditResult {
+  ok: boolean;
+  file: string;
+  mode: "symbol" | "line-range" | "search-replace";
+  replacedSpan: [number, number];
+  newSpan: [number, number];
+  diagnostics: StaticGuardDiagnostic[];
+  /** Compact 1-to-5 line plain-text receipt for the LLM. */
+  text: string;
+}
+
+export function executeSurgicalEdit(input: SurgicalEditInput): SurgicalEditResult {
+  const relPath = input.file.replace(/\\/g, "/").replace(/^\.\//, "");
+  const absPath = join(input.rootDir, relPath);
+  if (!existsSync(absPath)) {
+    return {
+      ok: false,
+      file: relPath,
+      mode: "symbol",
+      replacedSpan: [0, 0],
+      newSpan: [0, 0],
+      diagnostics: [],
+      text: `ERR [file-not-found] ${relPath}`,
+    };
+  }
+
+  const index = getWorkspaceAstIndex(input.rootDir);
+  const originalContent = readFileSync(absPath, "utf8");
+  const originalLines = originalContent.split(/\r?\n/);
+  const beforeAst = analyzeSourceFile(relPath, originalContent);
+
+  let mode: SurgicalEditResult["mode"] = "symbol";
+  let startLine = 1;
+  let endLine = 1;
+  let updatedContent = "";
+
+  if (input.symbol) {
+    mode = "symbol";
+    const sym = beforeAst.symbols.find((s) => s.name === input.symbol);
+    if (!sym) {
+      const available = beforeAst.symbols.map((s) => `${s.name}(L${s.line}-${s.endLine})`).join(", ");
+      return {
+        ok: false,
+        file: relPath,
+        mode,
+        replacedSpan: [0, 0],
+        newSpan: [0, 0],
+        diagnostics: [],
+        text: `ERR [symbol-not-found] '${input.symbol}' in ${relPath}. Available: ${available || "none"}`,
+      };
+    }
+    startLine = sym.line;
+    endLine = sym.endLine;
+    const newLines = input.newCode.split(/\r?\n/);
+    const merged = [
+      ...originalLines.slice(0, startLine - 1),
+      ...newLines,
+      ...originalLines.slice(endLine),
+    ];
+    updatedContent = merged.join("\n");
+  } else if (typeof input.startLine === "number" && typeof input.endLine === "number") {
+    mode = "line-range";
+    startLine = Math.max(1, input.startLine);
+    endLine = Math.min(originalLines.length, Math.max(startLine, input.endLine));
+    const newLines = input.newCode.split(/\r?\n/);
+    const merged = [
+      ...originalLines.slice(0, startLine - 1),
+      ...newLines,
+      ...originalLines.slice(endLine),
+    ];
+    updatedContent = merged.join("\n");
+  } else if (typeof input.oldCode === "string" && input.oldCode.length > 0) {
+    mode = "search-replace";
+    const idx = originalContent.indexOf(input.oldCode);
+    if (idx === -1) {
+      return {
+        ok: false,
+        file: relPath,
+        mode,
+        replacedSpan: [0, 0],
+        newSpan: [0, 0],
+        diagnostics: [],
+        text: `ERR [oldCode-not-found] Exact match not found in ${relPath}. Call gf_read(targets=["${relPath}"]) to inspect current line numbers.`,
+      };
+    }
+    const prefix = originalContent.slice(0, idx);
+    startLine = prefix.split(/\r?\n/).length;
+    endLine = startLine + input.oldCode.split(/\r?\n/).length - 1;
+    updatedContent =
+      originalContent.slice(0, idx) +
+      input.newCode +
+      originalContent.slice(idx + input.oldCode.length);
+  } else {
+    return {
+      ok: false,
+      file: relPath,
+      mode: "symbol",
+      replacedSpan: [0, 0],
+      newSpan: [0, 0],
+      diagnostics: [],
+      text: `ERR [invalid-args] Provide 'symbol', ('startLine' + 'endLine'), or 'oldCode'.`,
+    };
+  }
+
+  const newLineCount = input.newCode.split(/\r?\n/).length;
+  const newSpan: [number, number] = [startLine, startLine + newLineCount - 1];
+
+  // ── Zero-LLM Instant Static Guard ──
+  const afterAst = analyzeSourceFile(relPath, updatedContent);
+  const diagnostics: StaticGuardDiagnostic[] = [];
+
+  // 1. Check AST Syntax Errors
+  for (const synErr of afterAst.syntaxErrors) {
+    diagnostics.push({
+      severity: "error",
+      kind: "syntax",
+      location: `${relPath}:${synErr.line}${synErr.column !== undefined ? `:${synErr.column}` : ""}`,
+      message: synErr.message,
+    });
+  }
+
+  if (diagnostics.some((d) => d.severity === "error") && input.rejectOnSyntaxError !== false) {
+    const updatedLines = updatedContent.split(/\r?\n/);
+    const firstErr = afterAst.syntaxErrors[0]!;
+    const contextSnippet = formatNumberedLines(
+      updatedLines,
+      Math.max(1, firstErr.line - 2),
+      Math.min(updatedLines.length, firstErr.line + 2)
+    );
+    return {
+      ok: false,
+      file: relPath,
+      mode,
+      replacedSpan: [startLine, endLine],
+      newSpan,
+      diagnostics,
+      text: [
+        `REJECTED [syntax-error] Edit rolled back for ${relPath}:`,
+        ...diagnostics.map((d) => `  - ${d.location}: ${d.message}`),
+        contextSnippet,
+      ].join("\n"),
+    };
+  }
+
+  // Write file and invalidate AST cache for this file
+  writeFileSync(absPath, updatedContent, "utf8");
+  index.invalidateFile(relPath);
+
+  // 2. Check broken relative imports in the updated file
+  for (const imp of afterAst.imports) {
+    if (imp.module.startsWith(".")) {
+      const resolved = resolveRelativeImportPath(input.rootDir, relPath, imp.module);
+      if (!resolved) {
+        diagnostics.push({
+          severity: "warn",
+          kind: "broken-import",
+          location: `${relPath}:${imp.line}`,
+          message: `Relative import '${imp.module}' does not resolve to a file on disk`,
+        });
+      }
+    }
+  }
+
+  // 3. Check Removed Exports & Caller Arity Drift across the workspace
+  const afterSymbolsByName = new Map(afterAst.symbols.map((s) => [s.name, s]));
+  for (const oldSym of beforeAst.symbols) {
+    if (!oldSym.exported) continue;
+    const newSym = afterSymbolsByName.get(oldSym.name);
+    if (!newSym || !newSym.exported) {
+      const blast = computeBlastRadius(index, relPath, oldSym.name, 4);
+      if (blast.importers.length > 0 || blast.totalCallSites > 0) {
+        const sites = [
+          ...blast.callSites.map((c) => `${c.file}:${c.line}`),
+          ...blast.importers.map((i) => `${i.file}:${i.line}`),
+        ].slice(0, 4);
+        diagnostics.push({
+          severity: "warn",
+          kind: "removed-export-still-imported",
+          location: `${relPath}:${startLine}`,
+          message: `Export '${oldSym.name}' was removed/unexported but is still referenced at: ${sites.join(", ")}`,
+        });
+      }
+    } else if (
+      typeof oldSym.paramsCount === "number" &&
+      typeof newSym.paramsCount === "number" &&
+      oldSym.paramsCount !== newSym.paramsCount
+    ) {
+      const blast = computeBlastRadius(index, relPath, oldSym.name, 5);
+      for (const site of blast.callSites) {
+        if (site.argsCount > newSym.paramsCount) {
+          diagnostics.push({
+            severity: "warn",
+            kind: "caller-arity-mismatch",
+            location: `${site.file}:${site.line}`,
+            message: `Caller passes ${site.argsCount} arg(s) to '${newSym.name}', which now declares ${newSym.paramsCount} param(s)`,
+          });
+        }
+      }
+    }
+  }
+
+  const diagLines =
+    diagnostics.length > 0
+      ? ["Static Guard Warnings:", ...diagnostics.map((d) => `  ! [${d.kind}] ${d.location}: ${d.message}`)]
+      : [];
+
+  return {
+    ok: true,
+    file: relPath,
+    mode,
+    replacedSpan: [startLine, endLine],
+    newSpan,
+    diagnostics,
+    text: [
+      `OK [edited ${relPath}] L${startLine}-${endLine} -> L${newSpan[0]}-${newSpan[1]} (${diagnostics.length === 0 ? "AST syntax & callers clean" : `${diagnostics.length} warning(s)`})`,
+      ...diagLines,
+    ].join("\n"),
+  };
+}
